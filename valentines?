<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Be My Valentine? 💖</title>
    <style>
        /* 🌸 Pastel Pink Background */
        body {
            background-color: #ffe6f2; /* Soft pastel pink */
            font-family: 'Comic Sans MS', cursive, sans-serif;
            text-align: center;
            padding: 0;
            margin: 0;
            overflow: hidden;
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            position: relative;
        }

        /* 🎀 Cute Ribbon Decorations */
        .ribbon {
            width: 100%;
            height: 50px;
            background: #ffb6c1; /* Pastel Pink Ribbon */
            position: absolute;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: white;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .ribbon-top { top: 0; }
        .ribbon-bottom { bottom: 0; }

        /* 💌 Responsive Valentine Box */
        .container {
            width: min(80vw, 600px); /* Makes sure it fits on all screens */
            background: #ffd9e8; /* Lighter Pastel Pink */
            padding: 30px;
            border-radius: 20px;
            box-shadow: 0px 5px 15px rgba(0, 0, 0, 0.1);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        /* 💖 Cute Message */
        h1 {
            color: #ff4d6d; /* Slightly darker pink */
            font-size: 28px;
            text-align: center;
        }

        /* 🎀 Buttons */
        .btn {
            background-color: #ffb6c1;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 18px;
            border-radius: 10px;
            cursor: pointer;
            margin: 10px;
            transition: 0.3s;
            position: relative;
        }

        .btn:hover {
            background-color: #ff85a2;
        }

        /* 🏃‍♂️ Moving "No" Button */
        .no-btn {
            position: absolute;
            transition: 0.1s ease-in-out;
        }

    </style>
</head>
<body>

    <!-- 🎀 Cute Ribbons -->
    <div class="ribbon ribbon-top">💕 Special Valentine Message 💕</div>

    <div class="container">
        <h1 id="question">Will you be my Valentine? 💖</h1>
        <button class="btn" onclick="sayYes()" id="yesButton">Yes! 💕</button>
        <button class="btn no-btn" id="noButton" onmouseover="moveNo()">No 😢</button>
    </div>

    <div class="ribbon ribbon-bottom">🎀 Love is in the air 🎀</div>

    <script>
        let yesButton = document.getElementById("yesButton");
        let noButton = document.getElementById("noButton");
        let yesSize = 18; // Initial font size for "Yes" button

        function sayYes() {
            document.getElementById("question").innerText = "Yay! You’re my Valentine! 💖🎉";
            yesButton.style.display = "none";
            noButton.style.display = "none";
        }

        function moveNo() {
            let maxX = window.innerWidth - noButton.offsetWidth;
            let maxY = window.innerHeight - noButton.offsetHeight;
            
            let x = Math.random() * maxX;
            let y = Math.random() * maxY;

            noButton.style.left = x + "px";
            noButton.style.top = y + "px";

            // Make the "Yes" button grow bigger
            yesSize += 5;
            yesButton.style.fontSize = yesSize + "px";
            yesButton.style.padding = (yesSize / 3) + "px " + (yesSize / 2) + "px";
        }
    </script>

</body>
</html>
